DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noshow_recovery

ANTHROPIC_API_KEY=
CLAUDE_MODEL=

CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM_NUMBER=
# Comma-separated ClickSend number(s) concierge owns. The inbound webhook ignores
# any message delivered to a number not in this list. Defaults to CLICKSEND_FROM_NUMBER.
CONCIERGE_INBOUND_NUMBERS=

SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# Instantly customer-workspace API key (needs the emails:create scope). Used to
# send the one-off no-show email via POST /api/v2/emails/test.
INSTANTLY_API_KEY=

APP_BASE_URL=http://localhost:3000
CRON_SECRET=

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
