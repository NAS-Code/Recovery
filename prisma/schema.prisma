generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  scheduled
  no_show
  in_reschedule_convo
  confirmed_reschedule
  in_virtual_convo
  confirmed_virtual
  context_question
  not_interested
  uncategorized
}

enum MessageDirection {
  inbound
  outbound
}

model Client {
  id     String  @id @default(cuid())
  name   String
  events Event[]
  leads  Lead[]

  @@map("clients")
}

model Event {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  timezone  String   @default("America/New_York")
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  leads     Lead[]

  @@index([clientId])
  @@index([startDate, endDate])
  @@map("events")
}

model Lead {
  id                   String         @id @default(cuid())
  name                 String
  phone                String
  email                String?
  company              String?
  clientId             String         @map("client_id")
  client               Client         @relation(fields: [clientId], references: [id])
  eventId              String         @map("event_id")
  event                Event          @relation(fields: [eventId], references: [id])
  vendeluxLeadId       String?        @unique @map("vendelux_lead_id")
  nativeSchedulingLink String?        @map("native_scheduling_link")
  fdeOwnerSlackId      String?        @map("fde_owner_slack_id")
  status               LeadStatus     @default(scheduled)
  scheduledMeetingTime DateTime?      @map("scheduled_meeting_time")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt      @map("updated_at")
  conversations        Conversation[]

  @@index([clientId])
  @@index([eventId])
  @@index([status])
  @@index([phone])
  @@map("leads")
}

model Conversation {
  id                   String           @id @default(cuid())
  leadId               String           @map("lead_id")
  lead                 Lead             @relation(fields: [leadId], references: [id])
  direction            MessageDirection
  text                 String
  timestamp            DateTime         @default(now())
  claudeClassification Json?            @map("claude_classification")

  @@index([leadId, timestamp])
  @@map("conversations")
}
