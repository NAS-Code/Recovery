generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  scheduled
  no_show
  in_reschedule_convo
  confirmed_reschedule
  in_virtual_convo
  confirmed_virtual
  context_question
  not_interested
  uncategorized
  canceled
  pending_client_approval
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  initial_outreach
  auto_reply
  inbound_reply
  eod_checkin
  virtual_offer
}

model Client {
  id     String  @id @default(cuid())
  name   String
  events Event[]
  leads  Lead[]

  @@map("clients")
}

model Event {
  id               String   @id @default(cuid())
  name             String
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  timezone         String   @default("America/New_York")
  agentPersonaName String?  @map("agent_persona_name")
  boothLocation    String?  @map("booth_location")
  clientId         String   @map("client_id")
  client           Client   @relation(fields: [clientId], references: [id])
  leads            Lead[]

  @@index([clientId])
  @@index([startDate, endDate])
  @@map("events")
}

model Lead {
  id                   String         @id @default(cuid())
  name                 String
  phone                String
  email                String?
  company              String?
  clientId             String         @map("client_id")
  client               Client         @relation(fields: [clientId], references: [id])
  eventId              String         @map("event_id")
  event                Event          @relation(fields: [eventId], references: [id])
  sourceLeadId       String?        @unique @map("source_lead_id")
  nativeSchedulingLink String?        @map("native_scheduling_link")
  fdeOwnerSlackId      String?        @map("fde_owner_slack_id")
  status               LeadStatus     @default(scheduled)
  scheduledMeetingTime DateTime?      @map("scheduled_meeting_time")
  proposedMeetingTime  DateTime?      @map("proposed_meeting_time")
  suppressedAt         DateTime?      @map("suppressed_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt      @map("updated_at")
  conversations        Conversation[]

  @@index([clientId])
  @@index([eventId])
  @@index([status])
  @@index([phone])
  @@map("leads")
}

model Conversation {
  id                   String           @id @default(cuid())
  leadId               String           @map("lead_id")
  lead                 Lead             @relation(fields: [leadId], references: [id])
  direction            MessageDirection
  text                 String
  timestamp            DateTime         @default(now())
  claudeClassification Json?            @map("claude_classification")
  messageType          MessageType?     @map("message_type")

  @@index([leadId, timestamp])
  @@map("conversations")
}

model CampaignCredential {
  id            String              @id @default(cuid())
  username      String              @unique
  passwordHash  String              @map("password_hash")
  passwordPlain String              @map("password_plain")
  teamId        String              @map("team_id")
  eventId       String              @map("event_id")
  label         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  sessions      CampaignSession[]

  @@unique([teamId, eventId])
  @@map("campaign_credentials")
}

model CampaignSession {
  id           String              @id @default(cuid())
  token        String              @unique
  credentialId String              @map("credential_id")
  credential   CampaignCredential  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  expiresAt    DateTime            @map("expires_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([token])
  @@index([expiresAt])
  @@map("campaign_sessions")
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("admin_sessions")
}
